# Copy to .env and set real values locally. Never commit .env.
IMMICH_API_KEY=
BRIDGE_LOGIN_TOKEN=
BRIDGE_CONFIG_DIR=./bridge-config
BRIDGE_STATE_DIR=./bridge-state
BRIDGE_WORK_DIR=./bridge-work
# Parent read-only source mount; mount Immich originals here or use API downloads.
SOURCE_DIR=./sources
MEDIA_SDK_DEB=vendor/MediaSDK-3.1.5-linux-amd64.deb
BRIDGE_BIND=127.0.0.1
FRONTEND_PORT=3000
